# escucha-radar.service
#
# Este archivo hace que escucha_radar.py arranque solo cada vez que
# prende la Raspberry, igual que ya tenés configurado para el audio.
#
# DÓNDE VA ESTE ARCHIVO:
#   ~/.config/systemd/user/escucha-radar.service
#
# CÓMO INSTALARLO (una sola vez):
#   1) Copiar escucha_radar.py a tu carpeta de usuario:
#        cp escucha_radar.py ~/escucha_radar.py
#   2) Copiar este archivo a la carpeta de servicios de systemd:
#        mkdir -p ~/.config/systemd/user
#        cp escucha-radar.service ~/.config/systemd/user/
#   3) Avisarle a systemd que hay un servicio nuevo:
#        systemctl --user daemon-reload
#   4) Activarlo para que arranque solo en cada reinicio:
#        systemctl --user enable escucha-radar.service
#   5) Arrancarlo ahora mismo (sin esperar a reiniciar):
#        systemctl --user start escucha-radar.service
#
# CÓMO REVISAR QUE ESTÉ FUNCIONANDO:
#        systemctl --user status escucha-radar.service
#        cat /tmp/intensidad.txt

[Unit]
Description=Escucha los mensajes UDP del ESP32 y calcula la intensidad de movimiento
After=network.target

[Service]
WorkingDirectory=%h/ella/repo/pi/shared
ExecStart=%h/ella/repo/.venv/bin/python escucha_radar.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
