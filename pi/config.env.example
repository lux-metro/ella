# Archivo de configuración compartido para Instalación Ella
# Ubicación esperada: ~/ella/config.env

# --- Configuración de Audio ---
VOL_MIN=0.3
VOL_MAX=1.0
SPEED_MIN=0.85
SPEED_MAX=1.35

# --- Configuración de Sensores (Presencia) ---
# Tiempo (en segundos) que tarda la intensidad en pasar de 0 a 1.0 (subida)
# y de 1.0 a 0 (bajada). Valores más altos = transiciones más suaves.
TIEMPO_SUBIDA_SEG=2
TIEMPO_BAJADA_SEG=5
UMBRAL_PRESENCIA=0.5
