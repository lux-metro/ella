# =============================================================
# .gitignore — proyecto ella
# =============================================================

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# --- Logs del sistema ---
*.log
logs/

# --- Archivos de configuración local (contraseñas, IPs) ---
.env
*.env
secrets.yaml
credenciales_wifi.txt
/tmp/*.txt

# --- Sketch de test del radar WiFi (contiene credenciales locales) ---
# Se mantiene solo en local; no se sube al repositorio público.
tests/ESP32_c3_test_radar_rcwl0516/

# --- Sistemas operativos ---
.DS_Store           # Mac
Thumbs.db           # Windows
desktop.ini         # Windows

# --- Editores de texto ---
*.swp               # Vim
*.swo               # Vim
*~                  # Emacs backup
.vscode/            # VS Code
.idea/              # PyCharm

# --- Audio (archivos pesados de trabajo, NO los del repo) ---
# Los archivos de audio del proyecto SÍ van en el repo
# Solo excluimos archivos de audio temporales o de trabajo personal
*.wav.bak
*.aif
render/
